# ===== Acumulae — variáveis de ambiente =====
# Copie para .env e ajuste. Em produção (Dokploy), cadastre estas variáveis na aba "Environment".

# URL pública do app (sem barra no final). Usada nos links dos QRs, convites e e-mails.
PUBLIC_URL=http://localhost:3000

# Banco de dados
POSTGRES_USER=acumulae
POSTGRES_PASSWORD=acumulae
POSTGRES_DB=acumulae
DATABASE_URL=postgresql://acumulae:acumulae@postgres:5432/acumulae?schema=public

# Segredos (gere com: openssl rand -base64 48)
JWT_SECRET=troque-este-segredo-em-producao-jwt
QR_SECRET=troque-este-segredo-em-producao-qr
PLATFORM_API_KEY=troque-esta-chave-da-plataforma

# Opcional: restringe a API da plataforma a estes IPs (separados por vírgula). Vazio = qualquer IP.
PLATFORM_ALLOWED_IPS=

# Cookies com flag Secure (true em produção com HTTPS)
COOKIE_SECURE=false

# E-mail (dev: Mailpit em http://localhost:8025). Em produção: SMTP do Brevo, Resend, SES etc.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Acumulae <nao-responda@acumulae.com.br>"

# Login com Google (deixe vazio para desativar)
# URL de retorno a cadastrar no Google Cloud: {PUBLIC_URL}/api/auth/oauth2/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Login com Apple (feature flag; requer Apple Developer Program)
APPLE_ENABLED=false
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Conteúdo do arquivo .p8, com \n no lugar das quebras de linha
APPLE_PRIVATE_KEY=
